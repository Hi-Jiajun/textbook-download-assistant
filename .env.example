# 本文件只列出环境变量名，不放任何真实值。真实值请放在本机 .env（已被 .gitignore 排除）。
#
# 以下变量用于「赞助/授权码后端」的本地开发。若暂时不接后端，可留空，App 会以离线模式运行。
# 所有被读取的环境变量都必须在此声明，否则 NOFX 打包前检查会报错。

# 赞助/授权码服务地址（例如本地开发：http://10.0.2.2:8080 或生产 https://api.example.com）
LICENSE_API_BASE_URL=

# 爱发电 / 赞助页跳转链接（可选，填了才显示在 App 里）
SPONSOR_URL=

# 用于给“GitHub Star + 邮箱领码”的收件邮箱（可选）
SUPPORT_EMAIL=
